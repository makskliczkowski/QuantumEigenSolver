{
    "version": 4,
    "configurations": [
        {
            "name": "Mac",
            "includePath": [
                "${workspaceFolder}/cpqusolver/include",
                "${workspaceFolder}/cpqusolver/source/src",
                "${workspaceFolder}/cpqusolver/source",
                "${workspaceFolder}/cpqusolver",
                "${env:ARMADILLO_INCL_DIR}",
                "${env:MKL_INCL_DIR}",
                "/opt/homebrew/include",
                "/opt/homebrew/opt/hdf5/include",
                "/usr/local/include"
            ],
            "defines": [],
            "compilerPath": "/usr/bin/clang++",
            "cStandard": "c17",
            "cppStandard": "c++20",
            "intelliSenseMode": "macos-clang-arm64",
            "compileCommands": "${workspaceFolder}/cpqusolver/build/compile_commands.json"
        },
        {
            "name": "Linux",
            "includePath": [
                "${workspaceFolder}/cpqusolver/include",
                "${workspaceFolder}/cpqusolver/source/src",
                "${workspaceFolder}/cpqusolver/source",
                "${workspaceFolder}/cpqusolver",
                "${env:ARMADILLO_INCL_DIR}",
                "${env:MKL_INCL_DIR}",
                "/usr/include",
                "/usr/local/include"
            ],
            "defines": [],
            "compilerPath": "/usr/bin/g++",
            "cStandard": "c17",
            "cppStandard": "c++20",
            "intelliSenseMode": "linux-gcc-x64",
            "compileCommands": "${workspaceFolder}/cpqusolver/build/compile_commands.json"
        }
    ]
}
